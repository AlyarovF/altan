# ============================================================================
# ALTAN — PRODUCTION environment (self-managed server deploy).
#
# Copy to `.env.production` and fill in REAL secrets, then run ./deploy.sh
#   cp .env.production.example .env.production && ${EDITOR:-nano} .env.production
#
# `.env.production` is GITIGNORED — never commit real secrets. Generate strong
# random secrets with:  openssl rand -base64 48
# ============================================================================

# --- Public topology ---------------------------------------------------------
# Root domain that serves the public site (apps/web). No scheme.
DOMAIN=example.com
# Host that serves the admin dashboard (apps/admin). A subdomain is recommended.
ADMIN_HOST=admin.example.com
# Full public origin of the site (used for canonical URLs / sitemap / OG tags).
PUBLIC_SITE_URL=https://example.com
# Browser-facing API base. Keep RELATIVE so calls stay same-origin (the edge
# proxy forwards /api + /media to the api service — no CORS). Change only if the
# API is served from a different origin.
PUBLIC_API_BASE_URL=/api/v1
# Host port the edge nginx listens on. 80 in production (put TLS in front / here).
EDGE_HTTP_PORT=80
# EDGE_HTTPS_PORT=443

# CORS allow-list for the API (used when NOT going through the same-origin proxy).
# Set to the real public origins.
WEB_ORIGIN=https://example.com
ADMIN_ORIGIN=https://admin.example.com

# --- Database (postgres service) --------------------------------------------
POSTGRES_USER=altan
# REQUIRED — set a strong password. Must match DATABASE_URL below.
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=altan
# Connection string the API uses. Host = the `postgres` service name.
# Keep user/password/db in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql://altan:CHANGE_ME_strong_db_password@postgres:5432/altan?schema=public

# --- Redis (redis service) ---------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Auth secrets (REQUIRED) -------------------------------------------------
# Generate each with:  openssl rand -base64 48   (min 16 chars; use long values)
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_DIFFERENT_openssl_rand_base64_48
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# --- Bootstrap admin (seeded on first deploy: ./deploy.sh --seed) ------------
ADMIN_EMAIL=admin@example.com
# Min 8 chars. Change immediately after first login.
ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Media uploads -----------------------------------------------------------
# Absolute path inside the api container; backed by the `media_data` volume.
MEDIA_DIR=/data/media
# Max upload size in bytes (default 5 MB).
MEDIA_MAX_BYTES=5242880

# --- Rate limiting -----------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production

# --- Mail (OPTIONAL — owner-provided) ---------------------------------------
# ALTAN's MailerService ships as a LOG adapter (RFQ alerts are written to the
# structured logs, not emailed) until you wire a real SMTP provider. Fill these
# in and swap the MailerService binding to an SMTP adapter to send real mail.
# See DEPLOY.md > "Wiring a real SMTP provider".
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey_or_username
# SMTP_PASSWORD=CHANGE_ME_smtp_password
# SMTP_FROM="ALTAN Sales <sales@example.com>"
# SALES_ALERT_EMAIL=sales@example.com

# --- Compose (optional) ------------------------------------------------------
# Project name for the docker compose stack (isolates containers/volumes).
COMPOSE_PROJECT_NAME=altan
