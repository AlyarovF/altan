# ============================================================================
# ALTAN — PRODUCTION environment (self-managed server).  GITIGNORED — do not commit.
#
# Crypto secrets & passwords below were generated with `openssl rand`.
# BEFORE deploying you MUST edit the values marked >>> EDIT <<< (domain/hosts,
# and optionally SMTP). Then run:  ./deploy.sh --seed   (first deploy only).
# ============================================================================

# --- Public topology --------------------------------------------------------- >>> EDIT <<<
# Root domain that serves the public site (apps/web). No scheme.
DOMAIN=altan.info
# Host that serves the admin dashboard (apps/admin).
ADMIN_HOST=dashboard.altan.info
# Full public origin of the site (canonical URLs / sitemap / OG tags).
PUBLIC_SITE_URL=https://altan.info
# Browser-facing API base — keep RELATIVE so calls stay same-origin (no CORS).
PUBLIC_API_BASE_URL=/api/v1
# Host port the edge nginx listens on.
EDGE_HTTP_PORT=80
# EDGE_HTTPS_PORT=443

# CORS allow-list for the API.  >>> EDIT <<< to your real origins.
WEB_ORIGIN=https://altan.info
ADMIN_ORIGIN=https://dashboard.altan.info

# --- Database (postgres service) --------------------------------------------
POSTGRES_USER=altan
POSTGRES_PASSWORD=ef657C1Q649KdPMdVeTqqRjwlhoG9ke6
POSTGRES_DB=altan
# Connection string the API uses — password kept in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql://altan:ef657C1Q649KdPMdVeTqqRjwlhoG9ke6@postgres:5432/altan?schema=public

# --- Redis (redis service) ---------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Auth secrets (generated — keep private) --------------------------------
JWT_ACCESS_SECRET=7lGdBKtmGJC++u2F+S38+VSgKawd0JRcJwYza59L9VK55Lz47fePlnBNBLdSkdD4
JWT_REFRESH_SECRET=Lnf9Sb/xf3IMD4E/14dPytKymi+QP8jWQ5PDOO5/2/oMb/AIs5Ms5IBhvvqfFruJ
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# --- Bootstrap admin (seeded on first deploy: ./deploy.sh --seed) ------------ >>> EDIT email <<<
ADMIN_EMAIL=admin@altan.info
# Generated. Change immediately after first login.
ADMIN_PASSWORD=yM1a5pp3mMpJOAAkfevY

# --- Media uploads -----------------------------------------------------------
MEDIA_DIR=/data/media
MEDIA_MAX_BYTES=5242880

# --- Rate limiting -----------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production

# --- Mail (OPTIONAL — owner-provided) ---------------------------------------
# Leave blank to keep the log-only MailerService. Fill in to send real mail.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey_or_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM="ALTAN Sales <sales@altan.info>"
# SALES_ALERT_EMAIL=sales@altan.info

# --- Compose -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=altan
